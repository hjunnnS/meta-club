AUTH_URL=https://club.example.com
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
PORT=3000

OPERATOR_ACCOUNT_IDS=

# 영구 저장 위치 (기본값 data/club.sqlite)
CLUB_DB=data/club.sqlite
# 운영자가 지정하는 채팅 필터 문구. 쉼표로 구분한다.
CHAT_BLOCKED_TERMS=
# 승인 기록 JSON 파일의 경로와 계약상 서비스 지역
CLUB_MUSIC_CATALOG=
CLUB_TERRITORY=
# 미확정 추가 밀도 예산. 기본값은 승인된 AI 5명만 유지한다.
CLUB_AI_EXTRA_WHEN_EMPTY=0

# 로컬 HTTPS에서만 시험 회원과 G0 음원을 사용하려면 1로 설정한다.
CLUB_LOCAL_TEST=0
